# =============================================================================
# 环境变量模板 —— 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# 配置文件 conf/config_local.yaml 里的 ${VAR} 占位符会从这里注入。
# 敏感项（无默认值）缺失时程序会直接报错，请务必填写。
# =============================================================================

# ---------- 飞书 / Lark 应用凭证（必填）----------
LARK_APP_ID=cli_xxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 中国区飞书用 https://open.feishu.cn，国际版 Lark 用 https://open.larksuite.com
LARK_OPEN_API_BASE_URL=https://open.feishu.cn
# 可选：机器人 open_id（群聊判断是否被 @ 用）
LARK_BOT_OPEN_ID=
# 可选：默认发送群，配置后发送命令可省略 --chat-id
LARK_DEFAULT_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 消息转发（可选，不用可留空）----------
ENTERPRISE_SERVER_URL=
ENTERPRISE_SERVER_TOKEN=
FORWARD_TIMEOUT_SECONDS=2.5

# ---------- 大模型 / 百炼（必填 BAILIAN_API_KEY）----------
# 问答、embedding、rerank 共用这一个百炼 key
BAILIAN_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=deepseek-v4-pro
BAILIAN_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=qwen3-vl-rerank

# ---------- 可选：PPT 视觉转换 VLM（留空则回退纯文本）----------
VLM_API_KEY=
VLM_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VLM_MODEL=doubao-1-5-vision-pro-32k-250115

# ---------- Qdrant 向量库 ----------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledgebase

# ---------- MinIO 对象存储（必填 access/secret）----------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_CONSOLE_URL=http://127.0.0.1:9001/login

# ---------- RAG 问答参数 ----------
RAG_COLLECTION=knowledgebase
RAG_TOP_K=5
RAG_ENABLE_RERANK=true
RAG_CANDIDATE_TOP_K=50

# ---------- 并发兜底（削峰，防洪峰拖垮进程）----------
# RAG_WORKER_COUNT：同时处理问答的固定线程数 = 最多几路并发打百炼。人多可调大，
#   但受百炼限流约束，过大反而更容易触发 429。默认 10。
# RAG_QUEUE_MAXSIZE：排队上限。队列满时新提问被优雅拒绝（回「稍后再试」），
#   而不是无限堆积撑爆内存。默认 50。
RAG_WORKER_COUNT=10
RAG_QUEUE_MAXSIZE=50

# ---------- 对话记忆（多轮上下文：token 预算窗口 + 摘要）----------
# MEMORY_REWRITE_TURNS：改写/指代消解只用最近几轮（短，防把检索词带偏）。默认 2。
# MEMORY_SUMMARY_ENABLED：是否把超出预算的老对话压缩成摘要（关掉=按 token 裁老对话）。默认 true。
# MEMORY_SUMMARY_TRIGGER_TOKENS：全文轮次累计 token 超过它就把最早的老对话摘进摘要。默认 20000。
# MEMORY_SUMMARY_MAX_TOKENS：摘要本身的 token 上限，防摘要膨胀。默认 2000。
# MEMORY_TTL_SECONDS：会话多久无活动视为新话题并清空。默认 1800（30 分钟）。
# MEMORY_MAX_SESSIONS：全局会话上限，超出按 LRU 淘汰，防内存无限增长。默认 1000。
# MEMORY_PERSIST_PATH：SQLite 记忆持久化文件路径（如 logs/memory.db）。配了则重启/崩溃不丢多轮对话；留空=纯内存、重启失忆。
MEMORY_REWRITE_TURNS=2
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_TRIGGER_TOKENS=20000
MEMORY_SUMMARY_MAX_TOKENS=2000
MEMORY_TTL_SECONDS=1800
MEMORY_MAX_SESSIONS=1000
MEMORY_PERSIST_PATH=

# ---- Agent 工具调用（LangGraph 编排 Function Calling）----
# RAG_RECALL_QUALITY_MIN：召回最高分低于它视为召回不足（触发拒答或降级联网）。默认 0.68。
# RAG_MAX_TOOL_ROUNDS：Agent 工具调用循环上限(防绕圈/控成本)。默认 4。
# RAG_ENABLE_WEB_SEARCH：知识库召回不足时是否降级联网搜索。默认 true(需配 TAVILY_API_KEY 才实际生效，未配时优雅降级为不可用)。
RAG_RECALL_QUALITY_MIN=0.68
RAG_MAX_TOOL_ROUNDS=4
RAG_ENABLE_WEB_SEARCH=true


# ---------- 联网搜索（Tavily；知识库查不到时降级补充公开知识）----------
# TAVILY_API_KEY：Tavily API key（https://tavily.com 注册，免费额度 1000 次/月）。留空则联网搜索不可用（不报错）。
TAVILY_API_KEY=


